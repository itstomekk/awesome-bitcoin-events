{
  "name": "awesome-bitcoin-events",
  "version": "2.0.0",
  "description": "A source-aware, static calendar of Bitcoin events around the world",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "generate:event-lists": "node scripts/build_event_lists.mjs",
    "check:event-lists": "node scripts/build_event_lists.mjs --check",
    "scrape": "node scraper.js",
    "scrape:force": "node scraper.js --force"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": ["bitcoin", "events", "conferences", "astro"],
  "license": "MIT",
  "devDependencies": {
    "astro": "^5.14.1",
    "yaml": "^2.9.1"
  }
}
