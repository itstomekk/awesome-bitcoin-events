---
// Region-by-region list of recurring meetups, rendered from the "## Meetups" section of
// README.md, so those tables appear in exactly one place.
// `meetups` and `regions` come from loadMeetups() in src/lib/load-list.js.
const { meetups, regions } = Astro.props;

const COUNTRY_FLAGS = {
  'USA': '🇺🇸', 'Germany': '🇩🇪', 'France': '🇫🇷', 'Poland': '🇵🇱',
  'Spain': '🇪🇸', 'Italy': '🇮🇹', 'Netherlands': '🇳🇱', 'Switzerland': '🇨🇭',
  'Austria': '🇦🇹', 'Czech Republic': '🇨🇿', 'UK': '🇬🇧', 'Canada': '🇨🇦',
  'Australia': '🇦🇺', 'Japan': '🇯🇵', 'El Salvador': '🇸🇻', 'Argentina': '🇦🇷',
  'Brazil': '🇧🇷', 'Mexico': '🇲🇽', 'India': '🇮🇳', 'South Africa': '🇿🇦',
  'Norway': '🇳🇴', 'Sweden': '🇸🇪', 'Finland': '🇫🇮', 'Portugal': '🇵🇹',
  'Belgium': '🇧🇪', 'Hungary': '🇭🇺', 'Romania': '🇷🇴', 'Bulgaria': '🇧🇬',
  'Greece': '🇬🇷', 'Turkey': '🇹🇷', 'Serbia': '🇷🇸', 'Slovenia': '🇸🇮',
  'Croatia': '🇭🇷', 'Slovakia': '🇸🇰', 'Lithuania': '🇱🇹', 'Latvia': '🇱🇻',
  'Estonia': '🇪🇪', 'Ireland': '🇮🇪', 'Denmark': '🇩🇰', 'New Zealand': '🇳🇿',
  'Honduras': '🇭🇳', 'Costa Rica': '🇨🇷', 'Panama': '🇵🇦', 'Colombia': '🇨🇴',
  'Chile': '🇨🇱', 'Peru': '🇵🇪', 'Uruguay': '🇺🇾', 'Paraguay': '🇵🇾',
  'Bolivia': '🇧🇴', 'Ecuador': '🇪🇨', 'Venezuela': '🇻🇪',
  'United Arab Emirates': '🇦🇪', 'South Korea': '🇰🇷', 'Taiwan': '🇹🇼',
  'Vietnam': '🇻🇳', 'Philippines': '🇵🇭', 'Malaysia': '🇲🇾', 'Thailand': '🇹🇭',
  'Mauritius': '🇲🇺', 'Puerto Rico': '🇵🇷',
  'Hong Kong': '🇭🇰', 'Indonesia': '🇮🇩', 'Kenya': '🇰🇪', 'Malawi': '🇲🇼',
  'Cyprus': '🇨🇾', 'Montenegro': '🇲🇪', 'Cayman Islands': '🇰🇾', 'Curaçao': '🇨🇼', 'Dominican Republic': '🇩🇴',
};
function flagFor(country) {
  return country ? COUNTRY_FLAGS[country] || '' : '';
}
---
<div class="index">
  {regions.map((region) => (
    <section class="month">
      <div class="month-label"><h2>{region}</h2><span>{meetups.filter((m) => m.region === region).length} meetups</span></div>
      <ol class="rows">
        {meetups.filter((m) => m.region === region).map((m) => (
          <li class="row meetup-row" id={m.id}>
            <span class="row-date">{m.schedule}</span>
            <span class="row-title"><a href={m.url} target="_blank" rel="noreferrer">{m.name}</a><span class="arrow" aria-hidden="true"> ↗</span>{(m.links ?? []).map((l) => (<span class="also"> · <a href={l.url} target="_blank" rel="noreferrer">{l.label}</a></span>))}</span>
            <span class="row-where">{flagFor(m.country) ? flagFor(m.country) + ' ' : ''}{m.where}</span>
          </li>
        ))}
      </ol>
    </section>
  ))}
</div>
