---
// One card in the calendar. The data-* attributes are what the search and filters in
// index.astro read. Status is first rendered with the build date, then corrected in
// the browser with the visitor's date.
const { event, buildDay } = Astro.props;
const past = event.end < buildDay;
const start = new Date(`${event.start}T12:00:00Z`);
const month = start.toLocaleDateString('en-US', { month: 'short', timeZone: 'UTC' });
const day = start.toLocaleDateString('en-US', { day: '2-digit', timeZone: 'UTC' });
const year = event.start.slice(0, 4);
const titleId = `event-${event.id}`;
---
<article
  class:list={['event-card', 'is-verified', { 'is-past': past }]}
  data-event-card
  data-search={`${event.title} ${event.where} ${event.type}`.toLowerCase()}
  data-status={past ? 'past' : 'upcoming'}
  data-end={event.end}
  data-year={year}
  data-country={event.country || ''}
  data-type={event.type}
  aria-labelledby={titleId}
>
  <div class="event-card-topline">
    <span class="confidence-dot" aria-hidden="true"></span>
    <span>{event.type}</span>
    <span class="topline-rule"></span>
    <span>{year}</span>
  </div>
  <div class="event-card-content">
    <div class="date-block" aria-label={`${event.dateLabel}, ${year}`}>
      <span class="date-month">{month}</span>
      <strong class="date-day">{day}</strong>
      <span class="date-year">{year}</span>
    </div>
    <div class="event-copy">
      <p class="event-status">{past ? 'Past' : 'Upcoming'}</p>
      <h3 id={titleId}><a href={event.url} target="_blank" rel="noreferrer">{event.title}</a></h3>
      {event.note && <p class="event-series">{event.note}</p>}
      <p class="event-location"><span aria-hidden="true">⌖</span>{event.where}</p>
    </div>
  </div>
  <div class="event-card-footer">
    <span class="event-duration">{event.dateLabel}, {year}</span>
    <a class="text-link" href={event.url} target="_blank" rel="noreferrer">Official page <span aria-hidden="true">↗</span></a>
  </div>
</article>
