---
// Dedicated page for recurring meetups. MEETUPS.md stays the canonical file; the home
// page shows the same list as a tab, and this page gives it a real URL to link to.
import BaseLayout from '../layouts/BaseLayout.astro';
import MeetupList from '../components/MeetupList.astro';
import { loadMeetups } from '../lib/load-list.js';

const meetupResult = loadMeetups();
if (meetupResult.errors.length) throw new Error(`MEETUPS.md has errors (run \`npm run check\`):\n${meetupResult.errors.join('\n')}`);
const meetups = meetupResult.meetups;
const regions = [...new Set(meetups.map((m) => m.region))];
const countries = new Set(meetups.map((m) => m.country).filter(Boolean)).size;
const repo = 'https://github.com/itstomekk/awesome-bitcoin-events';
---
<BaseLayout
  title="Bitcoin meetups"
  description="Recurring Bitcoin meetups around the world, grouped by region and linked to the group's own page."
  page="meetups"
  canonical="meetups/"
  mast={`${meetups.length} meetups in ${countries} countries · updated with the list`}
>
  <main id="main-content">
    <div class="page">
      <section aria-labelledby="meetups-title">
        <h1 class="sr-only" id="meetups-title">Bitcoin meetups</h1>
        <p class="meetups-intro">Recurring Bitcoin meetups: turn up, meet people, learn. Times change, so check the link before you go. One-off events are in the <a href={`${import.meta.env.BASE_URL.replace(/\/?$/, '/')}`}>main list</a>.</p>
      </section>
      <MeetupList meetups={meetups} regions={regions} />
      <p class="meetups-intro">Missing your local meetup? Add a row to the right region's table in <a href={`${repo}/blob/main/MEETUPS.md`}>MEETUPS.md</a> and open a pull request. The format is in <a href={`${repo}/blob/main/.github/CONTRIBUTING.md#meetups`}>CONTRIBUTING.md</a>.</p>
    </div>
  </main>
</BaseLayout>
