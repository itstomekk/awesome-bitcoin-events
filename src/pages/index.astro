---
// Home page, built from README.md + PAST.md (the canonical awesome list).
//
// At build time: parse the list (src/lib/load-list.js), attach map points from
// data/places.json, and render every event as a card. The build fails on any list
// error, so a broken README line can never be deployed.
// In the browser: the <script> at the bottom decides upcoming vs past using the
// visitor's current date, so the site stays correct between deploys.
import BaseLayout from '../layouts/BaseLayout.astro';
import EventCard from '../components/EventCard.astro';
import { loadEvents, loadPlaces } from '../lib/load-list.js';
import { MONTHS } from '../lib/awesome-list.js';

const { events, errors } = loadEvents();
if (errors.length) throw new Error(`The event list has errors (run \`npm run check\`):\n${errors.join('\n')}`);
const places = loadPlaces();

const buildDay = new Date().toISOString().slice(0, 10);
const sorted = [...events].sort((a, b) => a.start.localeCompare(b.start) || a.title.localeCompare(b.title));
const upcoming = sorted.filter((event) => event.end >= buildDay);
const nextEvents = upcoming.slice(0, 3);
const years = [...new Set(sorted.map((event) => event.start.slice(0, 4)))].sort().reverse();
const countries = [...new Set(sorted.map((event) => event.country).filter(Boolean))].sort();
const types = [...new Set(sorted.map((event) => event.type))].sort();

// Group cards by month ("2026-10" -> events).
const groups = new Map();
for (const event of sorted) {
  const key = event.start.slice(0, 7);
  if (!groups.has(key)) groups.set(key, []);
  groups.get(key).push(event);
}

const mapEvents = sorted.filter((event) => places[event.where]).map((event) => ({
  title: event.title,
  url: event.url,
  dates: event.dateLabel,
  year: event.start.slice(0, 4),
  where: event.where,
  end: event.end,
  latitude: places[event.where][0],
  longitude: places[event.where][1],
}));
// Escapes "<" so the JSON can't close the <script> tag it is embedded in.
const mapJson = JSON.stringify(mapEvents).replace(/</g, '\\u003C');
const repo = 'https://github.com/itstomekk/awesome-bitcoin-events';
---
<BaseLayout title="Awesome Bitcoin Events: community calendar" description="A curated list of Bitcoin conferences, meetups, festivals and retreats around the world." map>
  <main id="main-content">
    <section class="hero-section">
      <div class="shell hero-grid">
        <div class="hero-copy">
          <p class="kicker"><span class="kicker-line"></span> The open Bitcoin events list</p>
          <h1>Find your people<br /><em>in the Bitcoin world.</em></h1>
          <p class="hero-lede">Conferences, meetups, festivals and retreats, each one linked to its organizer's official page. Curated in one plain Markdown list that anyone can edit.</p>
          <a class="button button-primary" href="#calendar">Browse the calendar <span aria-hidden="true">↓</span></a>
        </div>
        <div class="hero-aside" aria-label="Next events">
          <div class="orbit-mark" aria-hidden="true"><span>₿</span><i></i><i></i><i></i></div>
          <div class="next-events">
            <p class="eyebrow">Next events</p>
            {nextEvents.map((event) => (
              <a class="next-event" href={event.url} target="_blank" rel="noreferrer">
                <span class="next-event-date">{event.dateLabel}</span>
                <span><strong>{event.title}</strong><small>{event.where}</small></span>
                <span class="arrow" aria-hidden="true">↗</span>
              </a>
            ))}
          </div>
        </div>
      </div>
      <div class="shell signal-strip">
        <div><strong data-upcoming-count>{upcoming.length}</strong><span>upcoming events</span></div>
        <div><strong>{sorted.length}</strong><span>events listed</span></div>
        <div><strong>{countries.length}</strong><span>countries</span></div>
        <div><strong>1</strong><span>Markdown file to edit</span></div>
      </div>
    </section>

    <section class="map-section" id="map">
      <div class="shell">
        <div class="section-heading map-heading">
          <div>
            <p class="kicker"><span class="kicker-line"></span> The community, in place</p>
            <h2>Where Bitcoin meets.</h2>
          </div>
          <p class="section-note">Pins mark the city, not the exact venue. Orange pins are upcoming events and grey pins are past ones.</p>
        </div>
        <div class="map-layout">
          <div class="map-frame"><div id="event-map" role="img" aria-label="Map of Bitcoin events"></div><div class="map-credit">Map data © <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noreferrer">OpenStreetMap contributors</a></div></div>
          <aside class="map-summary">
            <p class="eyebrow">Map coverage</p>
            <strong class="map-total">{mapEvents.length}</strong>
            <p>of {sorted.length} events have a map pin. Online events and new cities without a pin still appear in the list.</p>
            <div class="map-key"><span class="map-key-dot venue"></span><span>Upcoming</span></div>
            <div class="map-key"><span class="map-key-dot past"></span><span>Past</span></div>
            <a class="text-link large" href="#calendar">Browse the full list <span aria-hidden="true">↘</span></a>
          </aside>
        </div>
      </div>
      <script type="application/json" id="map-data" set:html={mapJson}></script>
    </section>

    <section class="calendar-section" id="calendar">
      <div class="shell">
        <div class="section-heading">
          <div>
            <p class="kicker"><span class="kicker-line"></span> Browse the list</p>
            <h2>What’s happening next?</h2>
          </div>
          <p class="section-note">Search and filter by year, country or type. Every card links straight to the organizer.</p>
        </div>

        <div class="control-panel" aria-label="Calendar filters">
          <label class="search-field">
            <span class="sr-only">Search events</span>
            <span aria-hidden="true">⌕</span>
            <input id="event-search" type="search" placeholder="Search by event, city, or country" autocomplete="off" />
          </label>
          <div class="filter-tabs" role="group" aria-label="Event status">
            <button class="filter-tab is-active" type="button" data-status-filter="upcoming">Upcoming <span data-upcoming-count>{upcoming.length}</span></button>
            <button class="filter-tab" type="button" data-status-filter="all">All <span>{sorted.length}</span></button>
            <button class="filter-tab" type="button" data-status-filter="past">Past</button>
          </div>
          <label class="select-field">
            <span class="sr-only">Filter by year</span>
            <select id="year-filter"><option value="">Any year</option>{years.map((year) => <option value={year}>{year}</option>)}</select>
          </label>
          <label class="select-field">
            <span class="sr-only">Filter by country</span>
            <select id="country-filter"><option value="">Any country</option>{countries.map((country) => <option value={country}>{country}</option>)}</select>
          </label>
          <label class="select-field">
            <span class="sr-only">Filter by event type</span>
            <select id="type-filter"><option value="">Any type</option>{types.map((type) => <option value={type}>{type}</option>)}</select>
          </label>
          <p class="filter-result" id="filter-result" aria-live="polite">Showing upcoming events</p>
        </div>

        <noscript><p class="no-script">JavaScript is needed for search and filters. All events are listed below.</p></noscript>
        <div class="event-groups" id="event-groups">
          {[...groups].map(([key, group]) => (
            <section class="event-month" data-month-group>
              <div class="month-heading"><h3>{MONTHS[Number(key.slice(5)) - 1]}</h3><span>{key.slice(0, 4)}</span><i></i><small data-month-count>{group.length} events</small></div>
              <div class="event-grid">{group.map((event) => <EventCard event={event} buildDay={buildDay} />)}</div>
            </section>
          ))}
        </div>
        <div class="empty-state" id="empty-state" hidden>
          <span aria-hidden="true">∅</span><h3>No events match that view.</h3><p>Try widening your search or clearing one of the filters.</p><button class="button button-secondary" id="clear-filters" type="button">Clear filters</button>
        </div>
      </div>
    </section>

    <section class="method-section" id="method">
      <div class="shell method-grid">
        <div><p class="kicker"><span class="kicker-line"></span> How it works</p><h2>One list. Plain Markdown.</h2></div>
        <div class="method-copy">
          <p>The whole calendar is a single README file on GitHub, in the classic awesome-list style. This website is generated from that file, so there is no database and no second copy to keep in sync.</p>
          <div class="method-points">
            <div><strong>01</strong><span>Official links only</span><p>Each event links to its organizer's page. Unconfirmed leads wait in a separate to-verify list.</p></div>
            <div><strong>02</strong><span>Edit on GitHub</span><p>Add an event by adding one line to README.md, then opening a pull request.</p></div>
            <div><strong>03</strong><span>Checked automatically</span><p>Every change is validated for format, dates and duplicates before it goes live.</p></div>
          </div>
          <a class="text-link large" href={`${repo}/blob/main/README.md`} target="_blank" rel="noreferrer">Open the list on GitHub <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </section>
  </main>

  <script is:inline>
    // Upcoming vs past is decided here with the visitor's date, so it stays correct
    // even if the site hasn't been rebuilt since an event ended.
    const today = new Date().toISOString().slice(0, 10);
    const cards = [...document.querySelectorAll('[data-event-card]')];
    let upcomingCount = 0;
    cards.forEach((card) => {
      const past = card.dataset.end < today;
      card.dataset.status = past ? 'past' : 'upcoming';
      card.classList.toggle('is-past', past);
      const label = card.querySelector('.event-status');
      if (label) label.textContent = past ? 'Past' : 'Upcoming';
      if (!past) upcomingCount += 1;
    });
    document.querySelectorAll('[data-upcoming-count]').forEach((node) => { node.textContent = upcomingCount; });

    const search = document.querySelector('#event-search');
    const groups = [...document.querySelectorAll('[data-month-group]')];
    const statusButtons = [...document.querySelectorAll('[data-status-filter]')];
    const selects = [...document.querySelectorAll('.select-field select')];
    const result = document.querySelector('#filter-result');
    const empty = document.querySelector('#empty-state');
    let statusFilter = 'upcoming';

    function applyFilters() {
      const query = search.value.trim().toLowerCase();
      const year = document.querySelector('#year-filter').value;
      const country = document.querySelector('#country-filter').value;
      const type = document.querySelector('#type-filter').value;
      let visible = 0;
      cards.forEach((card) => {
        const matches = (!query || card.dataset.search.includes(query)) &&
          (statusFilter === 'all' || card.dataset.status === statusFilter) &&
          (!year || card.dataset.year === year) &&
          (!country || card.dataset.country === country) &&
          (!type || card.dataset.type === type);
        card.hidden = !matches;
        if (matches) visible += 1;
      });
      groups.forEach((group) => {
        const count = group.querySelectorAll('[data-event-card]:not([hidden])').length;
        group.hidden = count === 0;
        group.querySelector('[data-month-count]').textContent = `${count} event${count === 1 ? '' : 's'}`;
      });
      empty.hidden = visible !== 0;
      result.textContent = `Showing ${visible} event${visible === 1 ? '' : 's'}`;
    }
    statusButtons.forEach((button) => button.addEventListener('click', () => {
      statusFilter = button.dataset.statusFilter;
      statusButtons.forEach((item) => item.classList.toggle('is-active', item === button));
      applyFilters();
    }));
    [search, ...selects].forEach((control) => control.addEventListener('input', applyFilters));
    document.querySelector('#clear-filters').addEventListener('click', () => {
      search.value = '';
      selects.forEach((select) => { select.value = ''; });
      statusFilter = 'upcoming';
      statusButtons.forEach((item) => item.classList.toggle('is-active', item.dataset.statusFilter === 'upcoming'));
      applyFilters();
    });
    applyFilters();

    const mapNode = document.querySelector('#event-map');
    const mapData = JSON.parse(document.querySelector('#map-data').textContent);
    if (mapNode && window.L && mapData.length) {
      const eventMap = window.L.map(mapNode, { scrollWheelZoom: false, worldCopyJump: true });
      window.L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        maxZoom: 18,
        attribution: '&copy; OpenStreetMap contributors'
      }).addTo(eventMap);
      const escapeHtml = (value) => String(value).replace(/[&<>"']/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[char]);
      const bounds = [];
      mapData.forEach((event) => {
        const past = event.end < today;
        const colour = past ? '#a39e94' : '#f7931a';
        const point = window.L.circleMarker([event.latitude, event.longitude], {
          radius: past ? 5 : 7, color: colour, fillColor: colour, fillOpacity: .9, weight: 2
        }).addTo(eventMap);
        point.bindPopup(`<strong>${escapeHtml(event.title)}</strong><br><span>${escapeHtml(event.dates)}, ${escapeHtml(event.year)}</span><br><span>${escapeHtml(event.where)}</span><br><a href="${escapeHtml(event.url)}" target="_blank" rel="noreferrer">Official page ↗</a>`);
        bounds.push([event.latitude, event.longitude]);
      });
      eventMap.fitBounds(bounds, { padding: [24, 24], maxZoom: 4 });
      window.addEventListener('resize', () => eventMap.invalidateSize(), { passive: true });
    } else if (mapNode) {
      mapNode.innerHTML = '<p class="map-empty">The map could not load. The list below still works.</p>';
    }
  </script>
</BaseLayout>
