---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<BaseLayout title="Page not found — Signal Atlas" description="The requested Bitcoin event record could not be found.">
  <main id="main-content" class="not-found"><div class="shell"><p class="kicker"><span class="kicker-line"></span> Signal lost</p><h1>This record isn’t on the map.</h1><p>The page may have moved, or the event record may no longer be part of this dataset.</p><a class="button button-primary" href={base}>Return to calendar <span aria-hidden="true">→</span></a></div></main>
</BaseLayout>
