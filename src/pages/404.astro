---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<BaseLayout title="Page not found · Awesome Bitcoin Events" description="This page could not be found." noindex>
  <main id="main-content" class="page not-found">
    <h2>Nothing listed here.</h2>
    <p>Try the <a href={base}>full list of Bitcoin events</a> or the <a href={`${base}meetups/`}>meetups</a>.</p>
  </main>
</BaseLayout>
