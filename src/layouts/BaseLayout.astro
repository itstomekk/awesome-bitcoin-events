---
import '../styles/global.css';

const { title = 'Bitcoin Events — Signal Atlas', description = 'A source-aware calendar of Bitcoin events around the world.' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to calendar</a>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand" href={base} aria-label="Signal Atlas home">
          <span class="brand-mark">₿</span>
          <span class="brand-copy"><strong>Signal Atlas</strong><small>Bitcoin events</small></span>
        </a>
        <nav class="site-nav" aria-label="Primary navigation">
          <a href={`${base}#calendar`}>Calendar</a>
          <a href={`${base}#method`}>Method</a>
          <a class="nav-github" href="https://github.com/itstomekk/awesome-bitcoin-events" target="_blank" rel="noreferrer">GitHub <span aria-hidden="true">↗</span></a>
        </nav>
      </div>
    </header>
    <slot />
    <footer class="site-footer">
      <div class="shell footer-grid">
        <div>
          <a class="brand" href={base}><span class="brand-mark">₿</span><span class="brand-copy"><strong>Signal Atlas</strong><small>Bitcoin events</small></span></a>
          <p class="footer-note">An open, source-aware calendar for the people building the Bitcoin world.</p>
        </div>
        <div class="footer-links">
          <a href={`${base}#calendar`}>Browse events</a>
          <a href={`${base}#method`}>How it works</a>
          <a href="https://github.com/itstomekk/awesome-bitcoin-events" target="_blank" rel="noreferrer">Contribute on GitHub ↗</a>
        </div>
      </div>
      <div class="shell footer-bottom"><span>Data is versioned in this repository.</span><span>Built for the open web.</span></div>
    </footer>
  </body>
</html>
