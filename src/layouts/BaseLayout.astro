---
// Shared page shell: <head>, N6 masthead and Ft4 colophon. Pass `map` to load Leaflet
// (only the home page needs it); it comes from unpkg, pinned to 1.9.4 with SRI hashes.
import '../styles/global.css';
import '../styles/design-poster.css';

const {
  title = 'Awesome Bitcoin Events',
  description = 'A curated list of Bitcoin conferences, meetups, festivals and retreats around the world.',
  map = false,
  upcomingCount = null,
  countryCount = null,
  canonical = '',
  jsonld = null,
  noindex = false,
  // Path (relative to the base) of this page's Markdown copy for AI agents, e.g. 'index.md'.
  markdown = '',
  // Link-preview card: path under the base ('og/events/x.png'). Defaults to the shared og.jpg.
  ogImagePath = 'og.jpg',
  ogImageAlt = 'Awesome Bitcoin Events: a white rabbit mascot in front of a crowd and an orange-lit conference stage',
  // Pages with their own <h1> (event pages, hubs) pass false so the masthead is not a second h1.
  mastHeading = true,
  // Chrome-free page (the white paper viewer): no masthead, colophon or Support button; the page
  // supplies its own bar. Head, design switcher script and analytics stay.
  bare = false,
} = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const repo = 'https://github.com/itstomekk/awesome-bitcoin-events';
const built = new Date().toISOString().slice(0, 10);
// Absolute URL of this page for search engines and link previews. Omitted when the build
// has no configured origin (a bare local build without `site`).
const canonicalUrl = Astro.site ? new URL(`${base}${canonical}`, Astro.site).href : null;
// Link-preview image (public/og.jpg, 1200x630) and its alt text; absolute URL as crawlers require.
const ogImage = Astro.site ? new URL(`${base}${ogImagePath}`, Astro.site).href : null;
const ogAlt = ogImageAlt;
const Mast = mastHeading ? 'h1' : 'p';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Awesome Bitcoin Events" />
    {noindex && <meta name="robots" content="noindex" />}
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    {markdown && !noindex && <link rel="alternate" type="text/markdown" href={`${base}${markdown}`} />}
    {!noindex && <link rel="alternate" type="application/atom+xml" title="Upcoming Bitcoin events (Atom)" href={`${base}feed.xml`} />}
    {!noindex && <link rel="alternate" type="text/calendar" title="Upcoming Bitcoin events (calendar)" href={`${base}calendar.ics`} />}
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && <meta property="og:image:width" content="1200" />}
    {ogImage && <meta property="og:image:height" content="630" />}
    {ogImage && <meta property="og:image:alt" content={ogAlt} />}
    {canonicalUrl && <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />}
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    {ogImage && <meta name="twitter:image:alt" content={ogAlt} />}
    {jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld).replace(/</g, '\\u003C')}></script>}
    <meta name="msvalidate.01" content="12104CE87C2A256D7B405ACF97ABFE79" />
    <meta name="theme-color" id="theme-color-meta" content="#eef1f5" />
    <script is:inline>
      // Design switcher: "classic" (default) or "poster" (the Awesome Bitcoin Culture look). Runs before
      // first paint so there is no flash. Saved in localStorage; ?design=poster or ?design=classic
      // picks one and remembers it. The poster fonts are only fetched when that design is on.
      (() => {
        const KEY = 'abe-design';
        const FONTS = 'https://fonts.googleapis.com/css2?family=Archivo+Black&family=Space+Mono:wght@400;700&display=swap';
        let saved = null;
        try {
          const q = new URLSearchParams(location.search).get('design');
          if (q === 'poster' || q === 'classic') localStorage.setItem(KEY, q);
          saved = localStorage.getItem(KEY);
        } catch (e) { /* storage blocked: fall back to the query string only */ }
        const root = document.documentElement;
        function apply(design, persist) {
          if (design !== 'poster') design = 'classic';
          root.dataset.design = design;
          if (persist) { try { localStorage.setItem(KEY, design); } catch (e) { /* ignore */ } }
          if (design === 'poster' && !document.getElementById('poster-fonts')) {
            const link = document.createElement('link');
            link.id = 'poster-fonts'; link.rel = 'stylesheet'; link.href = FONTS;
            document.head.appendChild(link);
          }
          const meta = document.getElementById('theme-color-meta');
          if (meta) meta.setAttribute('content', design === 'poster' ? '#f7931a' : '#eef1f5');
          document.querySelectorAll('[data-design-choice]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.designChoice === design)));
          document.dispatchEvent(new CustomEvent('abe:design', { detail: design }));
        }
        window.abeSetDesign = (design) => apply(design, true);
        const fromQuery = /[?&]design=poster(&|$)/.test(location.search);
        apply(saved === 'poster' || (saved === null && fromQuery) ? 'poster' : 'classic', false);
      })();
    </script>
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    {!bare && <link rel="stylesheet" href={`${base}support.css`} />}
    {map && <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />}
    {map && <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>}
  </head>
  <body class={bare ? 'bare' : undefined}>
    {!bare && <a class="skip-link" href="#main-content">Skip to the list</a>}
    {!bare && <header class="nav-mast page">
      <Mast class="mast-name"><a href={base}><img class="mast-icon" src={`${base}icon.svg`} alt="" />Awesome Bitcoin Events</a><span class="mast-gh-slot"><a class="mast-gh" href={repo} target="_blank" rel="noreferrer" aria-label="Awesome Bitcoin Events on GitHub" title="View on GitHub"><svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg></a></span></Mast>
      <p class="mast-line">
        {upcomingCount !== null
          ? <><span data-upcoming-count>{upcomingCount}</span> upcoming · {countryCount} countries</>
          : 'The community list of Bitcoin events'}
      </p>
      <div class="design-switch" role="group" aria-label="Design">
        <span class="ds-label">Design</span>
        <button type="button" data-design-choice="classic" aria-pressed="true">Classic</button>
        <button type="button" data-design-choice="poster" aria-pressed="false">Poster</button>
      </div>
      <button type="button" id="sup" class="supb" aria-haspopup="dialog" title="Support the list with a Lightning zap"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M13.5 2 4 13.5h6.5L9 22l11-12.5h-6.8z" /></svg><span>Support</span><span class="supn"></span></button>
      <hr class="mast-rule" aria-hidden="true" />
    </header>}
    <slot />
    {!bare && <footer class="foot-dense page">
      <p>
        Awesome Bitcoin Events. Generated on {built} from <a href={`${repo}/blob/main/README.md`}>README.md</a> and
        <a href={`${repo}/blob/main/PAST.md`}>PAST.md</a>, the only places events are edited.
        List content dedicated to the public domain under CC0 1.0. Map data © <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors.
        Listing is not endorsement: check the organizer's page before you travel.
        Corrections and additions: <a href={`${repo}/blob/main/.github/CONTRIBUTING.md`}>CONTRIBUTING.md</a> or <a href={`${repo}/issues/new?template=event-submission.yml`}>the submission form</a>.
      </p>
    </footer>}
    <script is:inline>
      // The GitHub logo sits where the full stop used to be. On scroll it slides to the right
      // while it sticks to the top of the window, and parks in the top-right corner.
      (() => {
        const slot = document.querySelector('.mast-gh-slot');
        const link = document.querySelector('.mast-gh');
        if (!slot || !link) return;
        const END_SIZE = 22, END_PAD = 5, END_TOP = 10, END_RIGHT = 14, DISTANCE = 220;
        link.classList.add('is-floating');
        let queued = false;
        function place() {
          queued = false;
          const r = slot.getBoundingClientRect(); // the empty slot keeps the logo's place in the title
          const p = Math.min(1, Math.max(0, window.scrollY / DISTANCE));
          const e = p * p * (3 - 2 * p); // ease in and out
          const size = r.width + (END_SIZE - r.width) * e;
          const pad = END_PAD * e;
          const outer = size + 2 * pad;
          const parkedX = document.documentElement.clientWidth - END_RIGHT - outer;
          const x = r.left + (parkedX - r.left) * e;
          const y = Math.max(r.top, END_TOP); // sticky: rides up with the title, then holds at the top gap
          link.style.setProperty('--gh-size', size + 'px');
          link.style.setProperty('--gh-pad', pad + 'px');
          link.style.setProperty('--gh-x', x + 'px');
          link.style.setProperty('--gh-y', y + 'px');
          link.style.setProperty('--p', e.toFixed(3));
        }
        const queue = () => { if (!queued) { queued = true; requestAnimationFrame(place); } };
        addEventListener('scroll', queue, { passive: true });
        addEventListener('resize', queue);
        addEventListener('load', queue);
        if (document.fonts && document.fonts.ready) document.fonts.ready.then(queue);
        place();
      })();
    </script>
    <script is:inline>
      document.querySelectorAll('[data-design-choice]').forEach((b) => {
        b.setAttribute('aria-pressed', String(b.dataset.designChoice === document.documentElement.dataset.design));
        b.addEventListener('click', () => window.abeSetDesign && window.abeSetDesign(b.dataset.designChoice));
      });
    </script>
    {!bare && <script is:inline defer src={`${base}support.js`}></script>}
    <script data-goatcounter="https://awesomebtcevents.goatcounter.com/count" async src="//gc.zgo.at/count.js"></script>
  </body>
</html>
