{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/itstomekk/awesome-bitcoin-events/blob/main/data/schema/event-dataset.schema.json",
  "title": "Bitcoin event dataset",
  "type": "object",
  "required": ["schema_version", "generated_at", "records_total", "dataset_scope", "events"],
  "properties": {
    "schema_version": {"const": "event-dataset-1.0"},
    "generated_at": {"type": "string", "format": "date-time"},
    "records_total": {"type": "integer", "minimum": 0},
    "dataset_scope": {"type": "string"},
    "events": {"type": "array", "items": {"$ref": "#/$defs/event"}}
  },
  "additionalProperties": false,
  "$defs": {
    "event": {
      "type": "object",
      "required": ["id", "title", "series", "dates", "location", "classification", "organizer", "links", "description", "media", "lifecycle", "verification", "source_observations", "aliases"],
      "properties": {
        "id": {"type": "string", "pattern": "^evt-[a-z0-9-]+$"},
        "title": {"type": "string", "minLength": 1},
        "series": {"type": ["string", "null"]},
        "dates": {
          "type": "object",
          "required": ["start", "end", "timezone", "precision"],
          "properties": {
            "start": {"type": "string", "format": "date"},
            "end": {"type": "string", "format": "date"},
            "timezone": {"type": ["string", "null"]},
            "precision": {"enum": ["day"]}
          },
          "additionalProperties": false
        },
        "location": {
          "type": "object",
          "required": ["venue", "city", "region", "country", "country_code", "latitude", "longitude", "coordinates_precision"],
          "properties": {
            "venue": {"type": ["string", "null"]},
            "city": {"type": ["string", "null"]},
            "region": {"type": ["string", "null"]},
            "country": {"type": ["string", "null"]},
            "country_code": {"type": ["string", "null"], "pattern": "^[A-Z]{2}$"},
            "latitude": {"type": ["number", "null"]},
            "longitude": {"type": ["number", "null"]},
            "coordinates_precision": {"type": ["string", "null"]}
          },
          "additionalProperties": false
        },
        "classification": {
          "type": "object",
          "required": ["event_type", "topics", "bitcoin_relevance", "delivery_mode"],
          "properties": {
            "event_type": {"type": ["string", "null"]},
            "topics": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
            "bitcoin_relevance": {"type": "string"},
            "delivery_mode": {"enum": ["in_person", "online", "hybrid", "unknown"]}
          },
          "additionalProperties": false
        },
        "organizer": {
          "type": "object",
          "required": ["name", "urls"],
          "properties": {"name": {"type": ["string", "null"]}, "urls": {"type": "array", "items": {"type": "string", "format": "uri"}, "uniqueItems": true}},
          "additionalProperties": false
        },
        "links": {
          "type": "object",
          "required": ["official_url", "registration_url", "livestream_url", "social_urls"],
          "properties": {
            "official_url": {"type": ["string", "null"], "format": "uri"},
            "registration_url": {"type": ["string", "null"], "format": "uri"},
            "livestream_url": {"type": ["string", "null"], "format": "uri"},
            "social_urls": {"type": "array", "items": {"type": "string", "format": "uri"}, "uniqueItems": true}
          },
          "additionalProperties": false
        },
        "description": {"type": ["string", "null"]},
        "media": {"type": "object", "required": ["image_url"], "properties": {"image_url": {"type": ["string", "null"], "format": "uri"}}, "additionalProperties": false},
        "lifecycle": {"type": "object", "required": ["status", "published", "cancelled"], "properties": {"status": {"enum": ["announced", "past", "cancelled", "postponed", "unknown"]}, "published": {"type": ["boolean", "null"]}, "cancelled": {"type": "boolean"}}, "additionalProperties": false},
        "verification": {"type": "object", "required": ["state", "confidence", "last_verified_at", "notes"], "properties": {"state": {"enum": ["official_page_seen", "discovery_only", "legacy_imported", "needs_review"]}, "confidence": {"enum": ["unverified", "low", "medium", "high"]}, "last_verified_at": {"type": ["string", "null"], "format": "date-time"}, "notes": {"type": ["string", "null"]}}, "additionalProperties": false},
        "source_observations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source_observation"}},
        "aliases": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "legacy_payload": {"type": "object"},
        "legacy_dataset": {"type": "object"},
        "extensions": {"type": "object"}
      },
      "additionalProperties": false
    },
    "source_observation": {
      "type": "object",
      "required": ["source_id", "source_url", "event_url", "access_method", "observed_at"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "reported_source_id": {"type": "string", "minLength": 1},
        "source_url": {"type": "string"},
        "event_url": {"type": ["string", "null"]},
        "access_method": {"type": "string"},
        "observed_at": {"type": "string", "format": "date-time"},
        "reported_at": {"type": ["string", "null"]},
        "legacy_record_id": {"type": ["integer", "string", "null"]},
        "fields_observed": {"type": "array", "items": {"type": "string"}},
        "raw_excerpt": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    }
  }
}
